# Copy this file to `.env` and fill the values, then rebuild (`npm run build`).
# All three are OPTIONAL for local hacking: without them the extension runs in
# "developer mode" where you paste a personal Groq API key into the popup and
# the background worker calls Groq directly. With them, the extension uses the
# full PRD architecture: Google sign-in via Supabase Auth and the `optimize`
# Supabase Edge Function as the key-protecting backend proxy.

# Your Supabase project URL, e.g. https://abcdefghijklm.supabase.co
WXT_SUPABASE_URL=

# Your Supabase anon (public) API key
WXT_SUPABASE_ANON_KEY=

# Google OAuth 2.0 Web client ID (from Google Cloud Console) used for
# chrome.identity.launchWebAuthFlow -> supabase.auth.signInWithIdToken
WXT_GOOGLE_CLIENT_ID=
